# ============================================================================
# PLAYSOFLO ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit actual secrets to the repository.
# ============================================================================

# ============================================================================
# SUPABASE (REQUIRED - App will not start without these)
# ============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (Supabase project settings -> API -> service_role key). NEVER
# prefix this with VITE_ — that would ship it to the browser. Required by
# api/wallet.js, api/checkout.js, and other server endpoints that must
# bypass RLS with their own validation (never trust a client-supplied
# amount/identity for money movement).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# BASE44 INTEGRATION (Used throughout app for data management)
# ============================================================================
VITE_BASE44_APP_BASE_URL=https://base44.com/api

# ============================================================================
# EMAIL SERVICE (Optional - Required for email features)
# Configure in Vercel for production use
# ============================================================================
RESEND_API_KEY=re_your_resend_api_key_here

# ============================================================================
# SMS SERVICE (Optional - Required for SMS features)
# Configure in Vercel for production use
# ============================================================================
TWILIO_ACCOUNT_SID=ACyour_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# PAYMENT PROCESSING (Optional - Required for Stripe features)
# Configure in Vercel for production use
# ============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ============================================================================
# VIDEO CONFERENCING (Optional - Required for video call features)
# Configure in Vercel for production use
# ============================================================================
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# ============================================================================
# AI INTEGRATION (Optional - Required for AI/Ronron features)
# Configure in Vercel for production use
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# AI image generation (Optional - Required for GenerateImage / AI Studio
# image tools). Without this, /api/imagine returns a clear 501 instead of
# generating an image.
OPENAI_API_KEY=sk-your_openai_api_key_here

# ============================================================================
# ANALYTICS & MONITORING (Optional)
# Configure in Vercel for production use
# ============================================================================
POSTHOG_API_KEY=phc_your_posthog_key_here
NEXT_PUBLIC_POSTHOG_KEY=phc_your_public_posthog_key_here

# ============================================================================
# MAPS & LOCATION (Optional - Required for map features)
# Configure in Vercel for production use
# ============================================================================
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server-only (deliberately NOT prefixed with VITE_ -- Directions API calls
# are billed per request, so this key is never sent to the browser).
# Required for real turn-by-turn driver navigation (NavigationModal, live
# ride/delivery tracking). Create a key at
# https://console.cloud.google.com/google/maps-apis/credentials and enable
# the "Directions API" for your project. Without this, navigation returns a
# clear "not configured" message instead of crashing.
GOOGLE_MAPS_API_KEY=your_google_maps_server_api_key_here

# ============================================================================
# FLIGHTS (Optional - Required for Travel & Services > Flights)
# Sign up at https://app.duffel.com -- get your key under Developers > Access
# Tokens. Without this, /api/flights returns a clear 503 instead of crashing.
# ============================================================================
DUFFEL_API_KEY=duffel_test_your_duffel_api_key_here

# ============================================================================
# MUSIC HUB (Optional - Required for YouTube results in Music Hub search)
# Create a key at https://console.cloud.google.com/apis/credentials after
# enabling the "YouTube Data API v3" for your project. Without this,
# Music Hub search still works, but only searches the platform's own
# uploaded catalog -- no YouTube results are mixed in.
# ============================================================================
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# ============================================================================
# STREAMING (Optional - Required for "Browse Movies & Shows" in Streaming)
# Free to get: sign up at https://www.themoviedb.org, then create a key at
# https://www.themoviedb.org/settings/api (the "API Key (v3 auth)" value).
# Without this, movie/TV browsing returns a clear "not configured" message
# instead of crashing.
# ============================================================================
TMDB_API_KEY=your_tmdb_v3_api_key_here

# ============================================================================
# ENTERTAINMENT (Optional - Required for "Live Events" in Entertainment Experiences)
# Free, self-serve -- sign up at https://developer-acct.ticketmaster.com and
# create an app to get a Consumer Key. This is the Discovery API (event
# search), a separate product from Ticketmaster's Affiliate Program (which
# needs a real partnership and isn't built here). Free tier: 5 requests/sec,
# 5,000/day. Without this, live event search returns a clear "not
# configured" message instead of crashing.
# ============================================================================
TICKETMASTER_API_KEY=your_ticketmaster_discovery_api_key_here
